# 首次启动必填。至少 12 位，并满足大小写字母、数字、特殊字符中的至少三类。
ADMIN_PASSWORD=请替换为强密码
ADMIN_USERNAME=admin
PORT=5000
BIND_ADDRESS=0.0.0.0
# 例如 https://s.example.com；留空时根据访问地址生成。
PUBLIC_BASE_URL=
# HTTPS 反向代理部署时设为 true；同时将 TRUST_PROXY_COUNT 设为可信代理层数（通常 1）。
COOKIE_SECURE=false
TRUST_PROXY_COUNT=0
# 代理模式存在额外攻击面，默认关闭。仅在明确需要且理解 SSRF 风险时开启。
ENABLE_PROXY=false
WEB_WORKERS=2
TRUSTED_HOSTS=
