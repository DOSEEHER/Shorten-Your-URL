# 首次启动必填。至少 12 位，并满足大小写字母、数字、特殊字符中的至少三类。
ADMIN_PASSWORD=请替换为强密码
ADMIN_USERNAME=admin
PORT=5000
# 反向代理部署时务必保持 127.0.0.1，避免外部直连 5000 端口伪造 X-Forwarded-For；若直接对公网暴露则将 TRUST_PROXY_COUNT 设为 0。
BIND_ADDRESS=127.0.0.1
# 主管理与跳转域名，例如 https://s.example.com；留空时根据访问地址生成。
PUBLIC_BASE_URL=
# 推荐：独立代理渲染子域名（如 https://p.example.com），开启后管理后台在代理域不可见，彻底实现浏览器同源物理隔离。
PROXY_PUBLIC_BASE_URL=
# HTTPS 反向代理部署时设为 true；同时将 TRUST_PROXY_COUNT 设为可信代理层数（通常 1）。
COOKIE_SECURE=false
# 如果使用本地 Nginx/Caddy 反向代理，请设为 1；若无反向代理直连必须设为 0。
TRUST_PROXY_COUNT=1
# 允许访问的域名白名单（逗号分隔，启用 PROXY_PUBLIC_BASE_URL 时请同时填入两个域名，如 s.example.com,p.example.com）。
TRUSTED_HOSTS=
# 代理模式默认关闭。开启前建议配置 PROXY_PUBLIC_BASE_URL 独立域名。
ENABLE_PROXY=false
# 仅允许管理员账号创建或编辑代理模式短链接（默认 true）。
PROXY_ADMIN_ONLY=true
# 是否开启隔离命名空间的上游会话 Cookie 桥接（支持有状态目标站点，默认 true）。
ENABLE_PROXY_COOKIES=true
# 是否允许代理访问非 80/443 端口（默认 false，防止端口扫描滥用）。
PROXY_ALLOW_CUSTOM_PORTS=false
# 代理模式单响应最大体积（MB），承载含 WASM / 大型静态资源的 SPA 建议 >= 50。
PROXY_MAX_MB=50
# 代理模式单次 POST/PUT 请求体最大允许体积（MB）。
PROXY_MAX_REQUEST_MB=20
# 代理模式 HTML/CSS 重写缓冲上限（MB）。
PROXY_REWRITE_MAX_MB=25
# 单 Worker 最大并发 SSE 长连接数，避免耗尽线程池。
PROXY_MAX_SSE_STREAMS=6
WEB_WORKERS=2
WEB_THREADS=8
WEB_TIMEOUT=120
